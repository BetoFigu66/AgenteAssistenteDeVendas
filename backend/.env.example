# Twilio (opcional para POC inicial)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Alternativa ao Auth Token: API Key restrita (escopo de Messaging).
# Deixe vazias se for usar o Auth Token — vazio conta como "nao configurado".
# Declaradas em Settings porque extra=forbid derruba o boot com chave nao prevista.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Canal de saida (REQ-008, Fase 10): por onde a resposta chega ao cliente.
#   simulado -> grava no banco e NAO entrega nada (default; e o comportamento historico)
#   twilio   -> entrega de fato pelo WhatsApp
# Eixo INDEPENDENTE do modo de execucao (simulacao/conversa_controlada/execucao_normal),
# que decide se a resposta precisa de aprovacao humana antes de sair. Fica aqui no .env
# de proposito: trocar o modo pelo painel nunca deve, sozinho, comecar a mandar mensagem
# de verdade para um cliente.
CANAL_SAIDA=simulado

# Como o canal Twilio entrega a resposta SINCRONA do webhook:
#   twiml -> responde o proprio POST com <Message>. Unico caminho que funciona em conta
#            trial/Sandbox (a API recusa texto livre, erro 21654). O SID de saida chega
#            depois, pelo statusCallback.
#   rest  -> webhook devolve TwiML vazio e a mensagem sai pela API. SID na hora, exige
#            conta paga.
# Aprovacao e resposta manual usam SEMPRE REST: nao ha webhook aberto para responder.
TWILIO_MODO_ENVIO=twiml

# Base publica desta aplicacao (tunel Cloudflare). Usada para montar a URL de
# statusCallback e para validar a assinatura. Sem ela o modo twiml envia normalmente,
# mas nunca descobrimos o SID de saida e o "Responder" do WhatsApp fica sem resolver.
APP_URL_PUBLICA=

# Valida X-Twilio-Signature em /webhook e /webhook/status. Manter false enquanto
# CANAL_SAIDA=simulado (o testador de conversas chama o webhook e nao assina nada);
# ligar junto com CANAL_SAIDA=twilio. Usa o Auth Token da conta, nao a API Key.
TWILIO_VALIDAR_ASSINATURA=false

# Database (PostgreSQL)
# Docker expõe postgres na porta 5433 (para não conflitar com postgres local)
# Dentro do docker-compose (backend em container): host=postgres, porta=5432
# Backend rodando local: host=localhost, porta=5433
DATABASE_URL=postgresql://inforrel:inforrel_dev@localhost:5433/assistente_vendas

# API
API_HOST=0.0.0.0
# Dev local (run.sh): 8001 — QA (docker-compose): 8000
API_PORT=8001
DEBUG=true
LOG_LEVEL=WARNING
SQL_ECHO=false

# Autenticação do painel (REQ-010, Fase 4) — assina o cookie de sessão.
# Gere um valor forte em qualquer ambiente compartilhado/produção, ex.: openssl rand -hex 32
SESSION_SECRET_KEY=dev-secret-key-troque-em-producao
SESSION_MAX_AGE_SEGUNDOS=28800

# Gate de login em /api/*. TEMPORARIO: false libera tudo sem autenticar, para
# destravar dev/QA. Nunca deixar false com dado real de cliente.
AUTH_ENABLED=true
# Login assumido quando AUTH_ENABLED=false (fica como aprovador das mensagens).
# Vazio = primeiro usuario com login cadastrado.
AUTH_USUARIO_PADRAO=

# LLM Provider (groq | openai | gemini | ollama)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=your_api_key_here
LLM_TEMPERATURE=0.3

# Embeddings / RAG (openai | ollama)
# text-embedding-3-small -> 1536 dimensoes (compativel com a tabela documentos_conhecimento)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=your_openai_api_key_here

# RAG / Retrieval
RAG_ENABLED=true
RAG_TOP_K=4
RAG_SCORE_MINIMO=0.70
RAG_SUGERIR_PRODUTOS=false
RAG_EXIBIR_FONTES_PAINEL=true

# Consulta CNPJ
RECEITAWS_BASE_URL=https://www.receitaws.com.br/v1/cnpj

# Consulta CPF / crédito (REQ-015) — provedor a definir (serasa, spc, boavista, quod)
CPF_CONSULTA_CREDITO_ENABLED=false
# CPF_CONSULTA_CREDITO_PROVIDER=serasa
# CPF_CONSULTA_CREDITO_API_KEY=
# CPF_CONSULTA_CREDITO_BASE_URL=
