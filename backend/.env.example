# Twilio (opcional para POC inicial)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Database (PostgreSQL)
# Docker expõe postgres na porta 5433 (para não conflitar com postgres local)
# Dentro do docker-compose (backend em container): host=postgres, porta=5432
# Backend rodando local: host=localhost, porta=5433
DATABASE_URL=postgresql://inforrel:inforrel_dev@localhost:5433/assistente_vendas

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
