# API URL (deixe vazio para usar proxy do Vite em desenvolvimento)
VITE_API_URL=

# Dev local (run.sh) — backend nativo na 8001
VITE_DEV_PORT=3001
VITE_DEV_API_PROXY=http://127.0.0.1:8001

# Backend via Docker (docker-compose up): omita o .env ou use:
# VITE_DEV_API_PROXY=http://127.0.0.1:8000

# Em produção, configure para a URL do backend
# VITE_API_URL=https://api.exemplo.com
